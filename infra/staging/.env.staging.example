# Copier en `.env.staging` (gitignore) et remplir. Valeurs de STAGING uniquement,
# jamais les secrets de prod.

# Data services isoles (differents de la prod)
STAGING_POSTGRES_PASSWORD=NeoStaging2026!
STAGING_REDIS_PASSWORD=NeoStagingRedis2026!
STAGING_MINIO_USER=minioadmin
STAGING_MINIO_PASSWORD=NeoStagingMinio2026!

# Auth — 32+ caracteres, DIFFERENT de la prod
STAGING_JWT_SECRET=

# URLs staging — sous-domaine dedie neofilmtestapi.alkaya.fr (via NPM → conteneurs
# staging). Meme structure que la prod, juste un autre host.
STAGING_API_PUBLIC_URL=https://neofilmtestapi.alkaya.fr/api/v1
STAGING_CDN_BASE_URL=https://neofilmtestapi.alkaya.fr/neofilm-creatives
STAGING_CORS_ORIGINS=https://neofilmtestapi.alkaya.fr

# Stripe TEST (jamais les cles prod)
STAGING_STRIPE_SECRET_KEY=sk_test_...
STAGING_STRIPE_WEBHOOK_SECRET=whsec_...
